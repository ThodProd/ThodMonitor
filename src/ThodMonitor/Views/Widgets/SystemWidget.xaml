<UserControl x:Class="ThodMonitor.Views.Widgets.SystemWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}"><StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,16,0"><TextBlock Text="Процессор" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/><v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="92" Height="92" Thickness="9" Icon="cpu" HorizontalAlignment="Center" Value="{Binding CpuLoad.NumericValue}" IsAvailable="{Binding CpuLoad.IsAvailable}" Text="{Binding CpuLoad.RingText}" Warn="{Binding CpuLoad.Warn}" Crit="{Binding CpuLoad.Crit}" Mode="{Binding CfgSystem.ColorMode}" AccentColor="{Binding CfgSystem.Accent}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><v:IconView Icon="thermo" Width="16" Height="16" VerticalAlignment="Center" Stroke="{Binding CpuTemp.StateBrush}"/><TextBlock Text="{Binding CpuTemp.ValueText}" FontSize="16" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding CpuTemp.StateBrush}" Margin="3,0,0,0"/><TextBlock Text="{Binding CpuTemp.UnitText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,2"/></StackPanel></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Видеокарта" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/><v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="92" Height="92" Thickness="9" Icon="gpu" HorizontalAlignment="Center" Value="{Binding GpuLoad.NumericValue}" IsAvailable="{Binding GpuLoad.IsAvailable}" Text="{Binding GpuLoad.RingText}" Warn="{Binding GpuLoad.Warn}" Crit="{Binding GpuLoad.Crit}" Mode="{Binding CfgSystem.ColorMode}" AccentColor="{Binding CfgSystem.Accent}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><v:IconView Icon="thermo" Width="16" Height="16" VerticalAlignment="Center" Stroke="{Binding GpuTemp.StateBrush}"/><TextBlock Text="{Binding GpuTemp.ValueText}" FontSize="16" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding GpuTemp.StateBrush}" Margin="3,0,0,0"/><TextBlock Text="{Binding GpuTemp.UnitText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,2"/></StackPanel><StackPanel Margin="0,6,0,0" Width="92"><TextBlock Text="Видеопамять" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.75" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/><v:BarGauge Height="4" HorizontalAlignment="Stretch" Value="{Binding GpuVram.NumericValue}" IsAvailable="{Binding GpuVram.IsAvailable}" Warn="{Binding GpuVram.Warn}" Crit="{Binding GpuVram.Crit}" Mode="{Binding CfgSystem.ColorMode}" AccentColor="{Binding CfgSystem.Accent}"/><TextBlock Text="{Binding GpuVram.Note}" FontSize="10.5" Foreground="{Binding GpuVram.StateBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel><TextBlock Text="Оперативная память" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/><v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="92" Height="92" Thickness="9" Icon="ram" HorizontalAlignment="Center" Value="{Binding RamLoad.NumericValue}" IsAvailable="{Binding RamLoad.IsAvailable}" Text="{Binding RamLoad.RingText}" Warn="{Binding RamLoad.Warn}" Crit="{Binding RamLoad.Crit}" Mode="{Binding CfgSystem.ColorMode}" AccentColor="{Binding CfgSystem.Accent}"/><TextBlock Text="{Binding RamLoad.Note}" FontSize="12" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></StackPanel></UserControl>
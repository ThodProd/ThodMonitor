<UserControl x:Class="ThodMonitor.Views.Widgets.ClassicWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}">
  <ItemsControl ItemsSource="{Binding ClassicCards}" MinWidth="160">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <DockPanel Margin="0,1" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Foreground="{StaticResource TextDim}"
                     FontSize="{Binding DataContext.Settings.OsdFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
            <TextBlock Text="{Binding ValueText}" Foreground="{Binding StateBrush}" FontWeight="{DynamicResource ValueWeight}"
                       FontSize="{Binding DataContext.Settings.OsdFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
            <TextBlock Text="{Binding UnitText}" Foreground="{StaticResource TextDim}" Margin="3,0,0,0"
                       FontSize="{Binding DataContext.Settings.OsdFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
          </StackPanel>
        </DockPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

<UserControl x:Class="ThodMonitor.Views.Widgets.GpuWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}">
  <StackPanel Orientation="Horizontal">
    <v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="100" Height="100" Thickness="10" Icon="gpu"
                 Value="{Binding GpuLoad.NumericValue}" IsAvailable="{Binding GpuLoad.IsAvailable}" Text="{Binding GpuLoad.RingText}"
                 Warn="{Binding GpuLoad.Warn}" Crit="{Binding GpuLoad.Crit}"
                 Mode="{Binding CfgGpu.ColorMode}" AccentColor="{Binding CfgGpu.Accent}"/>
    <StackPanel Margin="14,0,4,0" VerticalAlignment="Center" MinWidth="110">
      <TextBlock Text="Видеокарта" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Left" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/>
      <StackPanel Orientation="Horizontal">
        <v:IconView Icon="thermo" Width="20" Height="20" VerticalAlignment="Center" Stroke="{Binding GpuTemp.StateBrush}"/>
        <TextBlock Text="{Binding GpuTemp.ValueText}" FontSize="24" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding GpuTemp.StateBrush}" Margin="4,0,0,0"/>
        <TextBlock Text="{Binding GpuTemp.UnitText}" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <v:IconView Icon="bolt" Width="16" Height="16" VerticalAlignment="Center" Stroke="{StaticResource TextDim}"/>
        <TextBlock Text="{Binding GpuPower.ValueText}" FontSize="15" Margin="6,0,0,0"/>
        <TextBlock Text="{Binding GpuPower.UnitText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
      </StackPanel>
      <StackPanel Margin="0,8,0,0" Width="118">
        <TextBlock Text="Видеопамять" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.75" Margin="0,0,0,2"
                   Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/>
        <v:BarGauge Height="4" HorizontalAlignment="Stretch"
                    Value="{Binding GpuVram.NumericValue}" IsAvailable="{Binding GpuVram.IsAvailable}"
                    Warn="{Binding GpuVram.Warn}" Crit="{Binding GpuVram.Crit}"
                    Mode="{Binding CfgGpu.ColorMode}" AccentColor="{Binding CfgGpu.Accent}"/>
        <TextBlock Text="{Binding GpuVram.Note}" FontSize="11" Foreground="{Binding GpuVram.StateBrush}" Margin="0,3,0,0"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>

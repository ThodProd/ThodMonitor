<UserControl x:Class="ThodMonitor.Views.Widgets.CpuWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}">
  <StackPanel Orientation="Horizontal">
    <v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="100" Height="100" Thickness="10" Icon="cpu"
                 Value="{Binding CpuLoad.NumericValue}" IsAvailable="{Binding CpuLoad.IsAvailable}" Text="{Binding CpuLoad.RingText}"
                 Warn="{Binding CpuLoad.Warn}" Crit="{Binding CpuLoad.Crit}"
                 Mode="{Binding CfgCpu.ColorMode}" AccentColor="{Binding CfgCpu.Accent}"/>
    <StackPanel Margin="14,0,4,0" VerticalAlignment="Center" MinWidth="86">
      <TextBlock Text="Процессор" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Left" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/>
      <StackPanel Orientation="Horizontal">
        <v:IconView Icon="thermo" Width="20" Height="20" VerticalAlignment="Center" Stroke="{Binding CpuTemp.StateBrush}"/>
        <TextBlock Text="{Binding CpuTemp.ValueText}" FontSize="24" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding CpuTemp.StateBrush}" Margin="4,0,0,0"/>
        <TextBlock Text="{Binding CpuTemp.UnitText}" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <v:IconView Icon="bolt" Width="16" Height="16" VerticalAlignment="Center" Stroke="{StaticResource TextDim}"/>
        <TextBlock Text="{Binding CpuPower.ValueText}" FontSize="15" Margin="6,0,0,0"/>
        <TextBlock Text="{Binding CpuPower.UnitText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
        <TextBlock Text="{Binding CpuClock.ValueText}" FontSize="12" Foreground="{StaticResource TextDim}"/>
        <TextBlock Text="{Binding CpuClock.UnitText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="3,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl x:Class="ThodMonitor.Views.Widgets.RamWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}">
  <StackPanel Orientation="Horizontal">
    <v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="100" Height="100" Thickness="10" Icon="ram"
                 Value="{Binding RamLoad.NumericValue}" IsAvailable="{Binding RamLoad.IsAvailable}" Text="{Binding RamLoad.RingText}"
                 Warn="{Binding RamLoad.Warn}" Crit="{Binding RamLoad.Crit}"
                 Mode="{Binding CfgRam.ColorMode}" AccentColor="{Binding CfgRam.Accent}"/>
    <StackPanel Margin="14,0,4,0" VerticalAlignment="Center" MinWidth="86">
      <TextBlock Text="Оперативная память" FontSize="9" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.7" HorizontalAlignment="Left" Margin="0,0,0,2" Visibility="{Binding Settings.ShowLabels, Converter={StaticResource B2V}}"/>
      <TextBlock Text="{Binding RamLoad.Note}" FontSize="17" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding RamLoad.StateBrush}"/>
      <TextBlock Text="занято" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl x:Class="ThodMonitor.Views.EdgeBlockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ThodMonitor.Visuals" xmlns:views="clr-namespace:ThodMonitor.Views" Foreground="{StaticResource Text}" FontFamily="{DynamicResource ValueFont}" TextOptions.TextFormattingMode="Ideal">
  <StackPanel MinWidth="116" Margin="6">
    <!-- подпись -->
    <TextBlock Text="{Binding Caption}" FontSize="9.5" FontWeight="{DynamicResource ValueWeight}" Foreground="{StaticResource TextDim}" Opacity="0.75"
               HorizontalAlignment="Center" Margin="0,0,0,3" Visibility="{Binding CaptionVisible, Converter={StaticResource B2V}}"/>

    <!-- кольцо -->
    <StackPanel Visibility="{Binding EffectiveStyle, Converter={StaticResource Eq}, ConverterParameter=Ring}">
      <v:RingGauge FontWeight="{DynamicResource ValueWeight}" Width="{Binding RingSize}" Height="{Binding RingSize}" Thickness="{Binding RingThickness}" Icon="{Binding Icon}" HorizontalAlignment="Center"
                   Value="{Binding Primary.NumericValue}" IsAvailable="{Binding Primary.IsAvailable}" Text="{Binding Primary.RingText}"
                   Warn="{Binding Primary.Warn}" Crit="{Binding Primary.Crit}"/>
      <TextBlock Text="{Binding Primary.Note}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{Binding Primary.StateBrush}"
                 Visibility="{Binding ShowPrimaryNote, Converter={StaticResource B2V}}"/>
    </StackPanel>

    <!-- число -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding EffectiveStyle, Converter={StaticResource Eq}, ConverterParameter=Number}">
      <v:IconView Icon="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" Stroke="{Binding Primary.StateBrush}" Margin="0,0,6,0"/>
      <TextBlock Text="{Binding Primary.ValueText}" FontSize="{Binding NumberFont}" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding Primary.StateBrush}"/>
      <TextBlock Text="{Binding Primary.UnitText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
    </StackPanel>

    <!-- полоса -->
    <StackPanel Visibility="{Binding EffectiveStyle, Converter={StaticResource Eq}, ConverterParameter=Bar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding Primary.ValueText}" FontSize="15" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding Primary.StateBrush}"/>
          <TextBlock Text="{Binding Primary.UnitText}" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
        </StackPanel>
        <v:IconView Icon="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Stroke="{Binding Primary.StateBrush}"/>
      </DockPanel>
      <v:BarGauge Height="8" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                  Value="{Binding Primary.NumericValue}" IsAvailable="{Binding Primary.IsAvailable}" Warn="{Binding Primary.Warn}" Crit="{Binding Primary.Crit}"/>
    </StackPanel>

    <!-- строка -->
    <DockPanel Visibility="{Binding EffectiveStyle, Converter={StaticResource Eq}, ConverterParameter=Line}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="{Binding Primary.ValueText}" FontSize="14" FontWeight="{DynamicResource ValueWeight}" Foreground="{Binding Primary.StateBrush}"/>
        <TextBlock Text="{Binding Primary.UnitText}" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
      </StackPanel>
      <v:IconView Icon="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Stroke="{Binding Primary.StateBrush}"/>
    </DockPanel>

    <!-- дополнительные показатели: маленькие строки -->
    <ItemsControl ItemsSource="{Binding Extras}" ItemTemplate="{StaticResource ExtraRowTemplate}" Margin="0,6,0,0"/>
  </StackPanel>
</UserControl>